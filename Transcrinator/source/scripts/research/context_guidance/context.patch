 }
+
+// Transcrinator experiment: additive API, existing ABI and entry points unchanged.
+extern "C" int transcrinator_context_set(parakeet_ctx* ctx, const char* phrases, float strength, int prefix) {
+    if (!ctx || !ctx->model) return 1;
+    try {
+        std::shared_ptr<pk::ContextBias> graph;
+        if (phrases && phrases[0] && strength > 0)
+            graph = std::make_shared<pk::ContextBias>(ctx->model->context_tokenizer_pieces(), phrases, strength, prefix);
+        std::atomic_store(&ctx->transcrinator_context, std::move(graph));
+        return 0;
+    } catch (const std::exception& error) { ctx->last_error = error.what(); return 1; }
+    catch (...) { ctx->last_error = "context compilation failed"; return 1; }
+}
+extern "C" char* transcrinator_transcribe_guided(parakeet_ctx* ctx, const float* samples,
+                                                 int count, int rate, int decoder) {
+    if (!ctx) return nullptr;
+    const auto graph = std::atomic_load(&ctx->transcrinator_context);
+    pk::ContextScope scope(graph.get());
+    char* result = parakeet_capi_transcribe_pcm(ctx, samples, count, rate, decoder);
+    ctx->transcrinator_changes.store(pk::context_changes);
+    return result;
+}
+extern "C" int transcrinator_context_last_changes(parakeet_ctx* ctx) {
+    return ctx ? ctx->transcrinator_changes.load() : 0;
+}
+// Call only after all model contexts have been freed and inference has stopped.
+extern "C" void transcrinator_shutdown_backend() {
+    pk::shutdown_backend();
+}
